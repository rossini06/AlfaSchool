# =============================================================
# AlfaSchool — variaveis do STAGING (LXC 118)
# Copie para .env.staging (chmod 600, fora do git) e preencha.
# Suba com:
#   docker compose --env-file .env.staging -f docker-compose.staging.yml up -d
# Gere segredos com: openssl rand -base64 48
# NUNCA reutilize os segredos de producao aqui (nem vice-versa).
# =============================================================

# Dominio publico do staging (Tailscale Funnel termina o TLS).
# Usado no CORS do backend. Sem "https://" aqui — o compose ja adiciona.
APP_DOMAIN=alfaschool.tail0939dd.ts.net

# --- MySQL (o backend conecta como root em mysql:3306/alfaschool) ---
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=alfaschool

# --- Backend (segredos obrigatorios; o backend recusa boot com padrao) ---
# Minimo 32 caracteres. Ex.: openssl rand -base64 48
APP_JWT_SECRET=
APP_SECRET_KEY=
# Admin inicial da plataforma (primeiro boot cria/garante este usuario)
APP_SUPERADMIN_EMAIL=superadmin@alfaschool.com
APP_SUPERADMIN_NAME=Super Admin
APP_SUPERADMIN_PASSWORD=

# --- Imagens (opcional) — o deploy-staging fixa o sha; latest e' o default ---
ALFASCHOOL_BACKEND_TAG=latest
ALFASCHOOL_FRONTEND_TAG=latest
